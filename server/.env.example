PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bantayledger
DB_PASSWORD=bantayledger
DB_NAME=bantayledger

# Only used by docker-compose.yml when creating the local MySQL container.
MYSQL_ROOT_PASSWORD=rootpassword

# Generate a real secret for any non-local environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-secret-change-me
